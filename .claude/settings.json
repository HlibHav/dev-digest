{
  "permissions": {
    "deny": [
      "Read(/server/clones/**)",
      "Edit(/server/clones/**)",
      "Edit(/server/src/db/migrations/meta/**)",
      "Bash(docker compose down -v *)",
      "Bash(docker compose down --volumes *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/agent-write-audit.py report"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/agent-write-audit.py report"
          }
        ]
      }
    ]
  }
}
