{
  "permissions": {
    "deny": [
      "Read(/server/clones/**)",
      "Edit(/server/clones/**)",
      "Edit(/server/src/db/migrations/meta/**)",
      "Bash(docker compose down -v *)",
      "Bash(docker compose down --volumes *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/pr-self-review.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
