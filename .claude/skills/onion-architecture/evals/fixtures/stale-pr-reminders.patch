@@ -0,0 +1,58 @@
+/**
+ * Reminders HTTP module.
+ *
+ *   GET  /reminders              → stale PRs in the workspace
+ *   POST /reminders/:id/send     → post a reminder on one PR now
+ *   POST /reminders/send         → 202 + jobId; reminds every stale PR in the background
+ */
+import type { FastifyInstance } from 'fastify';
+import type { ZodTypeProvider } from 'fastify-type-provider-zod';
+import { z } from 'zod';
+import { getContext } from '../_shared/context.js';
+import { IdParams } from '../_shared/schemas.js';
+import { NotFoundError } from '../../platform/errors.js';
+import { RemindersService } from './service.js';
+import { hoursSince, reminderBody, toStalePrDto } from './helpers.js';
+import { DEFAULT_STALE_HOURS, MAX_STALE_HOURS, REMINDER_JOB_KIND } from './constants.js';
+
+const ListQuery = z.object({
+  stale_hours: z.coerce.number().int().positive().max(MAX_STALE_HOURS).default(DEFAULT_STALE_HOURS),
+});
+
+const JobPayload = z.object({ workspaceId: z.string().uuid() });
+
+export default async function remindersRoutes(appBase: FastifyInstance) {
+  const app = appBase.withTypeProvider<ZodTypeProvider>();
+  const { container } = app;
+  const service = new RemindersService(container);
+
+  container.jobs.register(REMINDER_JOB_KIND, async (payload) => {
+    const { workspaceId } = JobPayload.parse(payload);
+    await service.sendAll(workspaceId);
+  });
+
+  app.get('/reminders', { schema: { querystring: ListQuery } }, async (req) => {
+    const { workspaceId } = await getContext(container, req);
+    const now = new Date();
+    const items = await service.listStale(workspaceId, req.query.stale_hours, now);
+    return { items: items.map((pr) => toStalePrDto(pr, now)) };
+  });
+
+  app.post('/reminders/:id/send', { schema: { params: IdParams } }, async (req, reply) => {
+    const { workspaceId } = await getContext(container, req);
+    const pr = await service.getPr(workspaceId, req.params.id);
+    if (!pr) throw new NotFoundError('Pull request not found');
+    const gh = await container.github();
+    await gh.postReview({ owner: pr.owner, name: pr.repo }, pr.number, {
+      body: reminderBody(pr, hoursSince(pr.updatedAt, new Date())),
+      event: 'COMMENT',
+    });
+    return reply.code(204).send();
+  });
+
+  app.post('/reminders/send', async (req, reply) => {
+    const { workspaceId } = await getContext(container, req);
+    const job = await container.jobs.enqueue(workspaceId, REMINDER_JOB_KIND, { workspaceId });
+    return reply.code(202).send({ job_id: job.id });
+  });
+}
diff --git a/server/src/modules/reminders/service.ts b/server/src/modules/reminders/service.ts
new file mode 100644
index 0000000..fac8d73
--- /dev/null
+++ b/server/src/modules/reminders/service.ts
@@ -0,0 +1,66 @@
+import { and, eq, lt } from 'drizzle-orm';
+import * as t from '../../db/schema.js';
+import type { Container } from '../../platform/container.js';
+import { DEFAULT_STALE_HOURS } from './constants.js';
+import { hoursSince, reminderBody, type StalePr } from './helpers.js';
+
+/**
+ * Stale-PR reminders. A pull request that has been `needs_review` for longer
+ * than the threshold gets one COMMENT review on GitHub nudging its author.
+ */
+export class RemindersService {
+  constructor(private container: Container) {}
+
+  async listStale(
+    workspaceId: string,
+    staleHours = DEFAULT_STALE_HOURS,
+    now = new Date(),
+  ): Promise<StalePr[]> {
+    const cutoff = new Date(now.getTime() - staleHours * 60 * 60 * 1000);
+    return this.selectPrs(
+      and(
+        eq(t.pullRequests.workspaceId, workspaceId),
+        eq(t.pullRequests.status, 'needs_review'),
+        lt(t.pullRequests.updatedAt, cutoff),
+      ),
+    );
+  }
+
+  async getPr(workspaceId: string, prId: string): Promise<StalePr | null> {
+    const [pr] = await this.selectPrs(
+      and(eq(t.pullRequests.workspaceId, workspaceId), eq(t.pullRequests.id, prId)),
+    );
+    return pr ?? null;
+  }
+
+  /** Post a reminder on every stale PR in the workspace. Returns how many were sent. */
+  async sendAll(workspaceId: string, now = new Date()): Promise<number> {
+    const stale = await this.listStale(workspaceId, DEFAULT_STALE_HOURS, now);
+    if (stale.length === 0) return 0;
+    const gh = await this.container.github();
+    for (const pr of stale) {
+      await gh.postReview({ owner: pr.owner, name: pr.repo }, pr.number, {
+        body: reminderBody(pr, hoursSince(pr.updatedAt, now)),
+        event: 'COMMENT',
+      });
+    }
+    return stale.length;
+  }
+
+  private async selectPrs(where: ReturnType<typeof and>): Promise<StalePr[]> {
+    return this.container.db
+      .select({
+        id: t.pullRequests.id,
+        repoId: t.pullRequests.repoId,
+        owner: t.repos.owner,
+        repo: t.repos.name,
+        number: t.pullRequests.number,
+        title: t.pullRequests.title,
+        author: t.pullRequests.author,
+        updatedAt: t.pullRequests.updatedAt,
+      })
+      .from(t.pullRequests)
+      .innerJoin(t.repos, eq(t.repos.id, t.pullRequests.repoId))
+      .where(where);
+  }
+}
