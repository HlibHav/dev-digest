@@ -0,0 +1,51 @@
+import { describe, it, expect } from 'vitest';
+import { hoursSince, reminderBody, toStalePrDto, type StalePr } from '../src/modules/reminders/helpers.js';
+import { REMINDER_MARKER } from '../src/modules/reminders/constants.js';
+
+const NOW = new Date('2026-10-07T12:00:00Z');
+
+const PR: StalePr = {
+  id: '00000000-0000-0000-0000-000000000001',
+  repoId: '00000000-0000-0000-0000-0000000000aa',
+  owner: 'acme',
+  repo: 'payments-api',
+  number: 42,
+  title: 'Add idempotency keys',
+  author: 'octocat',
+  updatedAt: new Date('2026-10-04T12:00:00Z'),
+};
+
+describe('hoursSince', () => {
+  it('counts whole hours', () => {
+    expect(hoursSince(new Date('2026-10-07T09:30:00Z'), NOW)).toBe(2);
+  });
+  it('is 0 for an unknown or future date', () => {
+    expect(hoursSince(null, NOW)).toBe(0);
+    expect(hoursSince(new Date('2026-10-08T00:00:00Z'), NOW)).toBe(0);
+  });
+});
+
+describe('reminderBody', () => {
+  it('carries the marker and mentions the author', () => {
+    const body = reminderBody(PR, 72);
+    expect(body.startsWith(REMINDER_MARKER)).toBe(true);
+    expect(body).toContain('@octocat');
+    expect(body).toContain('3 days');
+  });
+  it('uses hours below two days', () => {
+    expect(reminderBody(PR, 30)).toContain('30 hours');
+  });
+});
+
+describe('toStalePrDto', () => {
+  it('maps to the snake_case contract', () => {
+    expect(toStalePrDto(PR, NOW)).toEqual({
+      id: PR.id,
+      repo: 'acme/payments-api',
+      number: 42,
+      title: 'Add idempotency keys',
+      author: 'octocat',
+      waiting_hours: 72,
+    });
+  });
+});
