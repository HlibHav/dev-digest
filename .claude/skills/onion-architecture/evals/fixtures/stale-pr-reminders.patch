+/** Job kind for the workspace-wide reminder sweep. */
+export const REMINDER_JOB_KIND = 'reminders.send';
+
+/** A PR waiting for review longer than this is stale. */
+export const DEFAULT_STALE_HOURS = 48;
+
+/** Upper bound for the `stale_hours` query parameter (30 days). */
+export const MAX_STALE_HOURS = 24 * 30;
+
+/** Hidden marker so a reminder comment can be recognised on GitHub. */
+export const REMINDER_MARKER = '<!-- devdigest:reminder -->';
