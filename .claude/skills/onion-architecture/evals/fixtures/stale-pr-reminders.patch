new file mode 100644
index 0000000..ddfabdf
--- /dev/null
+++ b/server/src/modules/reminders/helpers.ts
@@ -0,0 +1,50 @@
+import { REMINDER_MARKER } from './constants.js';
+
+export interface StalePr {
+  id: string;
+  repoId: string;
+  owner: string;
+  repo: string;
+  number: number;
+  title: string;
+  author: string;
+  updatedAt: Date | null;
+}
+
+export interface StalePrDto {
+  id: string;
+  repo: string;
+  number: number;
+  title: string;
+  author: string;
+  waiting_hours: number;
+}
+
+const HOUR_MS = 60 * 60 * 1000;
+
+/** Whole hours between `date` and `now`; 0 when the date is unknown or in the future. */
+export function hoursSince(date: Date | null, now: Date): number {
+  if (!date) return 0;
+  return Math.max(0, Math.floor((now.getTime() - date.getTime()) / HOUR_MS));
+}
+
+export function reminderBody(pr: StalePr, hours: number): string {
+  const days = Math.floor(hours / 24);
+  const age = days >= 2 ? `${days} days` : `${hours} hours`;
+  return [
+    REMINDER_MARKER,
+    `This pull request has been waiting for review for ${age}.`,
+    `@${pr.author}, if it is still relevant, ping a reviewer or close it.`,
+  ].join('\n\n');
+}
+
+export function toStalePrDto(pr: StalePr, now: Date): StalePrDto {
+  return {
+    id: pr.id,
+    repo: `${pr.owner}/${pr.repo}`,
+    number: pr.number,
+    title: pr.title,
+    author: pr.author,
+    waiting_hours: hoursSince(pr.updatedAt, now),
+  };
+}
diff --git a/server/src/modules/reminders/routes.ts b/server/src/modules/reminders/routes.ts
