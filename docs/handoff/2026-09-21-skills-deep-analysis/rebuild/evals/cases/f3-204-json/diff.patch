+/** Bulk-dismiss every suggestion-level finding on a PR in one click. */
+export function useDismissAllSuggestions() {
+  const qc = useQueryClient();
+  return useMutation({
+    mutationFn: async (prId: string) => {
+      const res = await fetch(`${API_BASE}/pulls/${prId}/findings/dismiss-suggestions`, {
+        method: "POST",
+      });
+      return res.json();
+    },
+    onSuccess: (_data, prId) => {
+      qc.invalidateQueries({ queryKey: ["reviews", prId] });
+    },
+  });
+}
