index 0000000..d933de3
--- /dev/null
+++ b/server/src/modules/notify/helpers.ts
@@ -0,0 +1,31 @@
+export const SEVERITIES = ['critical', 'high', 'medium', 'low', 'info'] as const;
+export type Severity = (typeof SEVERITIES)[number];
+
+export interface ReviewDigest {
+  reviewId: string;
+  repoFullName: string;
+  prNumber: number;
+  prTitle: string;
+  verdict: string | null;
+  score: number | null;
+  summary: string | null;
+  counts: Partial<Record<Severity, number>>;
+}
+
+const MAX_SUMMARY_CHARS = 600;
+
+/** One Slack mrkdwn message for a finished review. */
+export function formatDigest(d: ReviewDigest): string {
+  const header = `*${d.repoFullName}#${d.prNumber}* ${d.prTitle}`;
+  const verdict = d.verdict ? `Verdict: *${d.verdict}*` : 'Verdict: n/a';
+  const score = d.score === null ? '' : ` · score ${d.score}/100`;
+  const counts = SEVERITIES.filter((s) => (d.counts[s] ?? 0) > 0)
+    .map((s) => `${s} ${d.counts[s]}`)
+    .join(' · ');
+  const summary = d.summary ? truncate(d.summary.trim(), MAX_SUMMARY_CHARS) : '';
+  return [header, `${verdict}${score}`, counts || 'No findings', summary].filter(Boolean).join('\n');
+}
+
+function truncate(text: string, max: number): string {
+  return text.length <= max ? text : `${text.slice(0, max - 1)}…`;
+}
diff --git a/server/src/modules/notify/repository.ts b/server/src/modules/notify/repository.ts
new file mode 100644
index 0000000..a2b1ed1
--- /dev/null
+++ b/server/src/modules/notify/repository.ts
@@ -0,0 +1,41 @@
+import { and, eq, sql } from 'drizzle-orm';
+import type { Db } from '../../db/client.js';
+import * as t from '../../db/schema.js';
+import { SEVERITIES, type ReviewDigest, type Severity } from './helpers.js';
+
+export class NotifyRepository {
+  constructor(private db: Db) {}
+
+  async loadDigest(workspaceId: string, reviewId: string): Promise<ReviewDigest | null> {
+    const [row] = await this.db
+      .select({
+        reviewId: t.reviews.id,
+        verdict: t.reviews.verdict,
+        score: t.reviews.score,
+        summary: t.reviews.summary,
+        prNumber: t.pullRequests.number,
+        prTitle: t.pullRequests.title,
+        repoFullName: t.repos.fullName,
+      })
+      .from(t.reviews)
+      .innerJoin(t.pullRequests, eq(t.pullRequests.id, t.reviews.prId))
+      .innerJoin(t.repos, eq(t.repos.id, t.pullRequests.repoId))
+      .where(and(eq(t.reviews.workspaceId, workspaceId), eq(t.reviews.id, reviewId)))
+      .limit(1);
+    if (!row) return null;
+
+    const counts = await this.db
+      .select({ severity: t.findings.severity, n: sql<number>`count(*)::int` })
+      .from(t.findings)
+      .where(eq(t.findings.reviewId, reviewId))
+      .groupBy(t.findings.severity);
+
+    const bySeverity: Partial<Record<Severity, number>> = {};
+    for (const c of counts) {
+      if ((SEVERITIES as readonly string[]).includes(c.severity)) {
+        bySeverity[c.severity as Severity] = c.n;
+      }
+    }
+    return { ...row, counts: bySeverity };
+  }
+}
diff --git a/server/src/modules/notify/routes.ts b/server/src/modules/notify/routes.ts
