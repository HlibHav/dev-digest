+++ b/server/src/modules/notify/routes.ts
@@ -0,0 +1,55 @@
+/**
+ * Notify HTTP module.
+ *
+ *   POST /reviews/:id/notify            → post the review summary to Slack
+ *   GET  /pulls/:id/notifiable-reviews  → the PR's reviews, newest first, for the picker
+ */
+import type { FastifyInstance } from 'fastify';
+import type { ZodTypeProvider } from 'fastify-type-provider-zod';
+import { and, desc, eq } from 'drizzle-orm';
+import * as t from '../../db/schema.js';
+import { getContext } from '../_shared/context.js';
+import { IdParams } from '../_shared/schemas.js';
+import { NotifyRepository } from './repository.js';
+import { NotifyService } from './service.js';
+
+const PICKER_LIMIT = 20;
+
+export default async function notifyRoutes(appBase: FastifyInstance) {
+  const app = appBase.withTypeProvider<ZodTypeProvider>();
+  const { container } = app;
+
+  const repo = new NotifyRepository(container.db);
+  const service = new NotifyService({
+    notifier: container.slack,
+    loadDigest: (workspaceId, reviewId) => repo.loadDigest(workspaceId, reviewId),
+  });
+
+  app.post('/reviews/:id/notify', { schema: { params: IdParams } }, async (req) => {
+    const { workspaceId } = await getContext(container, req);
+    return service.notifyReview(workspaceId, req.params.id);
+  });
+
+  app.get('/pulls/:id/notifiable-reviews', { schema: { params: IdParams } }, async (req) => {
+    const { workspaceId } = await getContext(container, req);
+    const rows = await container.db
+      .select({
+        id: t.reviews.id,
+        kind: t.reviews.kind,
+        verdict: t.reviews.verdict,
+        createdAt: t.reviews.createdAt,
+      })
+      .from(t.reviews)
+      .where(and(eq(t.reviews.workspaceId, workspaceId), eq(t.reviews.prId, req.params.id)))
+      .orderBy(desc(t.reviews.createdAt))
+      .limit(PICKER_LIMIT);
+    return {
+      items: rows.map((r) => ({
+        id: r.id,
+        kind: r.kind,
+        verdict: r.verdict,
+        created_at: r.createdAt.toISOString(),
+      })),
+    };
+  });
+}
diff --git a/server/src/modules/notify/service.ts b/server/src/modules/notify/service.ts
