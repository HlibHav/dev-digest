@@ -0,0 +1,34 @@
+import { ConfigError, ExternalServiceError } from '../../platform/errors.js';
+
+export interface SlackMessage {
+  text: string;
+}
+
+/**
+ * Slack incoming-webhook client. One POST per message; Slack answers `200 ok`
+ * on success and a plain-text error otherwise.
+ */
+export class SlackWebhookClient {
+  constructor(
+    private readonly webhookUrl: string | undefined = process.env.SLACK_WEBHOOK_URL,
+    private readonly timeoutMs = 10_000,
+  ) {}
+
+  get configured(): boolean {
+    return Boolean(this.webhookUrl);
+  }
+
+  async post(message: SlackMessage): Promise<void> {
+    if (!this.webhookUrl) throw new ConfigError('SLACK_WEBHOOK_URL is not set');
+    const res = await fetch(this.webhookUrl, {
+      method: 'POST',
+      headers: { 'content-type': 'application/json' },
+      body: JSON.stringify(message),
+      signal: AbortSignal.timeout(this.timeoutMs),
+    });
+    if (!res.ok) {
+      const detail = await res.text().catch(() => '');
+      throw new ExternalServiceError(`Slack webhook returned ${res.status}`, { detail });
+    }
+  }
+}
