+++ b/server/src/modules/notify/service.ts
@@ -0,0 +1,30 @@
+import { NotFoundError } from '../../platform/errors.js';
+import { formatDigest, type ReviewDigest } from './helpers.js';
+
+export interface ReviewNotifier {
+  readonly configured: boolean;
+  post(message: { text: string }): Promise<void>;
+}
+
+export interface NotifyPorts {
+  notifier: ReviewNotifier;
+  loadDigest(workspaceId: string, reviewId: string): Promise<ReviewDigest | null>;
+}
+
+export interface NotifyResult {
+  sent: boolean;
+  reason?: 'not_configured';
+}
+
+/** Posts a finished review's summary to the team's Slack channel. */
+export class NotifyService {
+  constructor(private ports: NotifyPorts) {}
+
+  async notifyReview(workspaceId: string, reviewId: string): Promise<NotifyResult> {
+    if (!this.ports.notifier.configured) return { sent: false, reason: 'not_configured' };
+    const digest = await this.ports.loadDigest(workspaceId, reviewId);
+    if (!digest) throw new NotFoundError('Review not found');
+    await this.ports.notifier.post({ text: formatDigest(digest) });
+    return { sent: true };
+  }
+}
