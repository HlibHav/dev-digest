diff --git a/server/test/notify-service.test.ts b/server/test/notify-service.test.ts
new file mode 100644
index 0000000..66cf23e
--- /dev/null
+++ b/server/test/notify-service.test.ts
@@ -0,0 +1,51 @@
+import { describe, it, expect, vi } from 'vitest';
+import { NotifyService, type ReviewNotifier } from '../src/modules/notify/service.js';
+import { formatDigest, type ReviewDigest } from '../src/modules/notify/helpers.js';
+import { NotFoundError } from '../src/platform/errors.js';
+
+const DIGEST: ReviewDigest = {
+  reviewId: 'r-1',
+  repoFullName: 'acme/payments-api',
+  prNumber: 42,
+  prTitle: 'Add idempotency keys',
+  verdict: 'request_changes',
+  score: 61,
+  summary: 'Retries can double-charge when the key is missing.',
+  counts: { high: 2, low: 1 },
+};
+
+function notifier(configured = true): ReviewNotifier & { post: ReturnType<typeof vi.fn> } {
+  return { configured, post: vi.fn(async () => {}) };
+}
+
+describe('NotifyService', () => {
+  it('posts the formatted digest', async () => {
+    const n = notifier();
+    const svc = new NotifyService({ notifier: n, loadDigest: async () => DIGEST });
+    await expect(svc.notifyReview('ws', 'r-1')).resolves.toEqual({ sent: true });
+    expect(n.post).toHaveBeenCalledWith({ text: formatDigest(DIGEST) });
+  });
+
+  it('does nothing when Slack is not configured', async () => {
+    const n = notifier(false);
+    const load = vi.fn(async () => DIGEST);
+    const svc = new NotifyService({ notifier: n, loadDigest: load });
+    await expect(svc.notifyReview('ws', 'r-1')).resolves.toEqual({ sent: false, reason: 'not_configured' });
+    expect(load).not.toHaveBeenCalled();
+    expect(n.post).not.toHaveBeenCalled();
+  });
+
+  it('throws NotFoundError for an unknown review', async () => {
+    const svc = new NotifyService({ notifier: notifier(), loadDigest: async () => null });
+    await expect(svc.notifyReview('ws', 'nope')).rejects.toBeInstanceOf(NotFoundError);
+  });
+});
+
+describe('formatDigest', () => {
+  it('lists only non-zero severities in order', () => {
+    expect(formatDigest(DIGEST)).toContain('high 2 · low 1');
+  });
+  it('says so when there are no findings', () => {
+    expect(formatDigest({ ...DIGEST, counts: {} })).toContain('No findings');
+  });
+});
