+import type { FastifyBaseLogger } from 'fastify';
+import type { Container } from '../../platform/container.js';
+import { BriefRepository } from '../brief/repository.js';
+import { resolveFeatureModel } from '../settings/feature-models.js';
+import { DigestRepository } from './repository.js';
+import { DigestService } from './service.js';
+
+/** Composition for the digest module. */
+export function buildDigestService(container: Container, log: FastifyBaseLogger): DigestService {
+  const repo = new DigestRepository(container.db);
+  const briefs = new BriefRepository(container.db);
+
+  return new DigestService({
+    listReviewed: (workspaceId, period) => repo.listReviewed(workspaceId, period),
+    findingCounts: (reviewIds) => repo.findingCounts(reviewIds),
+    briefHeadline: async (prId) => {
+      const stored = (await briefs.get(prId)) as { headline?: unknown } | undefined;
+      return typeof stored?.headline === 'string' ? stored.headline : null;
+    },
+    skillsInUse: async (workspaceId) => {
+      const rows = await container.skillsRepo.list(workspaceId);
+      return rows.filter((s) => s.enabled).map((s) => ({ id: s.id, name: s.name }));
+    },
+    resolveModel: (workspaceId) => resolveFeatureModel(container, workspaceId, 'review_intent'),
+    llm: (provider) => container.llm(provider),
+    save: (workspaceId, period, bodyMd, deliveredTo) => repo.save(workspaceId, period, bodyMd, deliveredTo),
+    list: (workspaceId) => repo.list(workspaceId),
+    get: (workspaceId, id) => repo.get(workspaceId, id),
+    log,
+  });
+}
