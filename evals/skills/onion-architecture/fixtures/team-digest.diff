+++ b/server/test/digest-service.test.ts
@@ -0,0 +1,67 @@
+import { describe, expect, it, vi } from 'vitest';
+
+vi.mock('node:fs/promises', () => ({ mkdir: vi.fn(async () => undefined), writeFile: vi.fn(async () => undefined) }));
+
+import { MockLLMProvider } from '../src/adapters/mocks.js';
+import { DigestService, type DigestPorts } from '../src/modules/digest/service.js';
+import { periodEndingAt, rankEntries, riskScore, type DigestEntry } from '../src/modules/digest/helpers.js';
+import { NotFoundError } from '../src/platform/errors.js';
+
+const NOW = new Date('2026-10-07T09:00:00Z');
+const log = { info: vi.fn(), warn: vi.fn(), error: vi.fn() } as unknown as DigestPorts['log'];
+
+function ports(over: Partial<DigestPorts> = {}): DigestPorts {
+  return {
+    listReviewed: async () => [
+      { reviewId: 'r1', prId: 'p1', repoFullName: 'acme/api', number: 1, title: 'Retry', verdict: 'approve', score: 90, reviewedAt: new Date('2026-10-05') },
+      { reviewId: 'r2', prId: 'p2', repoFullName: 'acme/web', number: 2, title: 'Auth', verdict: 'request_changes', score: 40, reviewedAt: new Date('2026-10-04') },
+    ],
+    findingCounts: async () => new Map([['r1', { low: 3 }], ['r2', { critical: 1 }]]),
+    briefHeadline: async (prId) => (prId === 'p2' ? 'Touches session handling' : null),
+    skillsInUse: async () => [{ id: 's1', name: 'api-contract' }],
+    resolveModel: async () => ({ provider: 'openai', model: 'gpt-4.1-mini' }),
+    llm: async () => new MockLLMProvider('openai', { completionText: 'A calm week.' }),
+    save: async () => 'd1',
+    list: async () => [],
+    get: async () => undefined,
+    log,
+    ...over,
+  };
+}
+
+describe('DigestService.generate', () => {
+  it('ranks the critical PR first and renders the headline', async () => {
+    const out = await new DigestService(ports()).generate('ws', periodEndingAt(NOW), null);
+    expect(out.id).toBe('d1');
+    expect(out.prs).toBe(2);
+    expect(out.bodyMd.indexOf('acme/web#2')).toBeLessThan(out.bodyMd.indexOf('acme/api#1'));
+    expect(out.bodyMd).toContain('A calm week.');
+    expect(out.bodyMd).toContain('Risk brief: Touches session handling');
+  });
+
+  it('skips the model when nothing was reviewed', async () => {
+    const llm = vi.fn();
+    const out = await new DigestService(ports({ listReviewed: async () => [], llm })).generate('ws', periodEndingAt(NOW), null);
+    expect(llm).not.toHaveBeenCalled();
+    expect(out.bodyMd).toContain('No pull requests were reviewed');
+  });
+});
+
+describe('DigestService.get', () => {
+  it('throws NotFoundError for an unknown digest', async () => {
+    await expect(new DigestService(ports()).get('ws', 'nope')).rejects.toBeInstanceOf(NotFoundError);
+  });
+});
+
+describe('helpers', () => {
+  it('weights severities', () => {
+    expect(riskScore({ critical: 1 })).toBeGreaterThan(riskScore({ low: 50 }));
+  });
+  it('caps and orders entries', () => {
+    const e = (id: string, crit: number): DigestEntry => ({
+      reviewId: id, prId: id, repoFullName: 'a/b', number: 1, title: id, verdict: null, score: null,
+      reviewedAt: NOW, counts: { critical: crit }, briefHeadline: null,
+    });
+    expect(rankEntries([e('a', 0), e('b', 2)]).map((x) => x.reviewId)).toEqual(['b', 'a']);
+  });
+});
