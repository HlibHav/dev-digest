@@ -0,0 +1,48 @@
+import { and, eq, isNotNull, isNull, lt, or } from 'drizzle-orm';
+import type { Db } from '../../db/client.js';
+import * as t from '../../db/schema.js';
+
+export type ReindexTx = Parameters<Parameters<Db['transaction']>[0]>[0];
+
+export interface StaleRepoRow {
+  repoId: string;
+  fullName: string;
+  indexedAt: Date | null;
+  status: string | null;
+}
+
+export class ReindexRepository {
+  constructor(private db: Db) {}
+
+  transaction<T>(work: (tx: ReindexTx) => Promise<T>): Promise<T> {
+    return this.db.transaction(work);
+  }
+
+  /** Cloned repos whose index is missing or older than `cutoff`, optionally in one workspace. */
+  async listStale(cutoff: Date, workspaceId?: string): Promise<StaleRepoRow[]> {
+    return this.db
+      .select({
+        repoId: t.repos.id,
+        fullName: t.repos.fullName,
+        indexedAt: t.repoIndexState.updatedAt,
+        status: t.repoIndexState.status,
+      })
+      .from(t.repos)
+      .leftJoin(t.repoIndexState, eq(t.repoIndexState.repoId, t.repos.id))
+      .where(
+        and(
+          isNotNull(t.repos.clonePath),
+          workspaceId ? eq(t.repos.workspaceId, workspaceId) : undefined,
+          or(isNull(t.repoIndexState.updatedAt), lt(t.repoIndexState.updatedAt, cutoff)),
+        ),
+      );
+  }
+
+  async deleteSymbols(tx: ReindexTx, repoId: string): Promise<void> {
+    await tx.delete(t.symbols).where(eq(t.symbols.repoId, repoId));
+  }
+
+  async deleteIndexState(tx: ReindexTx, repoId: string): Promise<void> {
+    await tx.delete(t.repoIndexState).where(eq(t.repoIndexState.repoId, repoId));
+  }
+}
