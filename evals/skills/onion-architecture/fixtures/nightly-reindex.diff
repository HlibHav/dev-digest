@@ -0,0 +1,16 @@
+export class StaleRepo {
+  constructor(
+    readonly repoId: string,
+    readonly fullName: string,
+    readonly indexedAt: Date | null,
+    readonly lastStatus: string | null,
+  ) {}
+
+  isNeverIndexed(): boolean {
+    return this.indexedAt === null;
+  }
+
+  ageMs(now: Date): number | null {
+    return this.indexedAt ? now.getTime() - this.indexedAt.getTime() : null;
+  }
+}
