@@ -0,0 +1,10 @@
+const HOUR_MS = 60 * 60 * 1000;
+
+/** How often the scheduler looks for stale repos. */
+export const REINDEX_INTERVAL_MS = 24 * HOUR_MS;
+
+/** An index older than this is rebuilt. */
+export const STALE_AFTER_MS = 7 * 24 * HOUR_MS;
+
+/** Repos rebuilt at the same time; indexing is CPU- and disk-heavy. */
+export const REINDEX_CONCURRENCY = 2;
