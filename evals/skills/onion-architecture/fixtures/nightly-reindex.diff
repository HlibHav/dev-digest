@@ -0,0 +1,22 @@
+import { StaleRepo } from './entity.js';
+import type { StaleRepoRow } from './repository.js';
+
+export interface StaleRepoDto {
+  repo_id: string;
+  full_name: string;
+  indexed_at: string | null;
+  last_status: string | null;
+}
+
+export function toStaleRepo(row: StaleRepoRow): StaleRepo {
+  return new StaleRepo(row.repoId, row.fullName, row.indexedAt, row.status);
+}
+
+export function toStaleRepoDto(repo: StaleRepo): StaleRepoDto {
+  return {
+    repo_id: repo.repoId,
+    full_name: repo.fullName,
+    indexed_at: repo.indexedAt ? repo.indexedAt.toISOString() : null,
+    last_status: repo.lastStatus,
+  };
+}
