+/** Job kind for "suggest and apply labels" on one PR. */
+export const LABELS_JOB_KIND = 'labels.suggest-apply';
+
+/** At most this many labels are suggested per PR. */
+export const MAX_LABELS = 5;
+
+export const LABELS_SCHEMA_NAME = 'PrLabelSuggestion';
+
+export const GITHUB_API_URL = 'https://api.github.com';
