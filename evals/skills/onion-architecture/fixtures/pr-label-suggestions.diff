@@ -0,0 +1,58 @@
+import { afterEach, describe, expect, it, vi } from 'vitest';
+import { MockLLMProvider } from '../src/adapters/mocks.js';
+import { LabelsService, type LabelablePr } from '../src/modules/labels/service.js';
+import { normalizeLabels } from '../src/modules/labels/helpers.js';
+import { NotFoundError } from '../src/platform/errors.js';
+
+const PR: LabelablePr = { number: 7, title: 'Fix flaky retry', body: 'Adds jitter', owner: 'acme', repo: 'api' };
+
+function service(llm = new MockLLMProvider('openai', { structured: { labels: ['BUG', 'made-up', 'ci'] } })) {
+  return new LabelsService({
+    getPull: async (_ws, id) => (id === 'pr-1' ? PR : undefined),
+    resolveModel: async () => ({ provider: 'openai', model: 'gpt-4.1-mini' }),
+    llm: async () => llm,
+  });
+}
+
+function stubGitHub(labels: string[]) {
+  const fetchMock = vi.fn(async (_url: string, init?: RequestInit) =>
+    new Response(init?.method === 'POST' ? '[]' : JSON.stringify(labels.map((name) => ({ name }))), { status: 200 }),
+  );
+  vi.stubGlobal('fetch', fetchMock);
+  return fetchMock;
+}
+
+afterEach(() => vi.unstubAllGlobals());
+
+describe('LabelsService', () => {
+  it('keeps only labels the repo has, in its spelling', async () => {
+    stubGitHub(['bug', 'ci', 'docs']);
+    await expect(service().suggest('ws', 'pr-1', 't')).resolves.toEqual(['bug', 'ci']);
+  });
+
+  it('skips the model when the repo has no labels', async () => {
+    stubGitHub([]);
+    const llm = new MockLLMProvider();
+    await expect(service(llm).suggest('ws', 'pr-1', 't')).resolves.toEqual([]);
+    expect(llm.calls).toHaveLength(0);
+  });
+
+  it('posts the labels to the PR', async () => {
+    const fetchMock = stubGitHub([]);
+    await service().apply('ws', 'pr-1', ['bug'], 't');
+    expect(fetchMock).toHaveBeenCalledWith(
+      'https://api.github.com/repos/acme/api/issues/7/labels',
+      expect.objectContaining({ method: 'POST', body: JSON.stringify({ labels: ['bug'] }) }),
+    );
+  });
+
+  it('throws NotFoundError for an unknown PR', async () => {
+    await expect(service().suggest('ws', 'nope', 't')).rejects.toBeInstanceOf(NotFoundError);
+  });
+});
+
+describe('normalizeLabels', () => {
+  it('dedupes and caps', () => {
+    expect(normalizeLabels(['a', 'A', 'b', 'c'], ['a', 'b', 'c'], 2)).toEqual(['a', 'b']);
+  });
+});
