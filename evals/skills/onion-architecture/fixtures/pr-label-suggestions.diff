+/**
+ * Labels HTTP module.
+ *
+ *   GET  /pulls/:id/labels/suggestions → labels the model picks from the repo's label set
+ *   POST /pulls/:id/labels/auto        → 202 + jobId; suggest and apply in the background
+ */
+import type { FastifyInstance } from 'fastify';
+import type { ZodTypeProvider } from 'fastify-type-provider-zod';
+import { getContext } from '../_shared/context.js';
+import { IdParams } from '../_shared/schemas.js';
+import { LABELS_JOB_KIND } from './constants.js';
+import { buildLabelsService } from './wiring.js';
+
+export default async function labelsRoutes(appBase: FastifyInstance) {
+  const app = appBase.withTypeProvider<ZodTypeProvider>();
+  const { container } = app;
+  const service = buildLabelsService(container, app.log);
+
+  app.get('/pulls/:id/labels/suggestions', { schema: { params: IdParams } }, async (req) => {
+    const { workspaceId } = await getContext(container, req);
+    const token = await container.secrets.get('GITHUB_TOKEN');
+    return { labels: await service.suggest(workspaceId, req.params.id, token) };
+  });
+
+  app.post('/pulls/:id/labels/auto', { schema: { params: IdParams } }, async (req, reply) => {
+    const { workspaceId } = await getContext(container, req);
+    const job = await container.jobs.enqueue(workspaceId, LABELS_JOB_KIND, {
+      workspaceId,
+      prId: req.params.id,
+    });
+    return reply.code(202).send({ job_id: job.id });
+  });
+}
diff --git a/server/src/modules/labels/service.ts b/server/src/modules/labels/service.ts
new file mode 100644
index 0000000..a9d6acb
--- /dev/null
+++ b/server/src/modules/labels/service.ts
@@ -0,0 +1,80 @@
+import type { FeatureModelChoice, LLMProvider } from '@devdigest/shared';
+import { ExternalServiceError, NotFoundError } from '../../platform/errors.js';
+import { GITHUB_API_URL, LABELS_SCHEMA_NAME } from './constants.js';
+import { LabelSuggestion, labelPrompt, normalizeLabels } from './helpers.js';
+
+export interface LabelablePr {
+  number: number;
+  title: string;
+  body: string | null;
+  owner: string;
+  repo: string;
+}
+
+export interface LabelsPorts {
+  getPull(workspaceId: string, prId: string): Promise<LabelablePr | undefined>;
+  resolveModel(workspaceId: string): Promise<FeatureModelChoice>;
+  llm(provider: FeatureModelChoice['provider']): Promise<LLMProvider>;
+}
+
+/** Suggests labels for a PR from the repo's own label set, and applies them on GitHub. */
+export class LabelsService {
+  constructor(private ports: LabelsPorts) {}
+
+  async suggest(workspaceId: string, prId: string, token: string | undefined): Promise<string[]> {
+    const pr = await this.requirePull(workspaceId, prId);
+    const allowed = await this.repoLabels(pr, token);
+    if (allowed.length === 0) return [];
+
+    const choice = await this.ports.resolveModel(workspaceId);
+    const llm = await this.ports.llm(choice.provider);
+    const { data } = await llm.completeStructured({
+      model: choice.model,
+      schema: LabelSuggestion,
+      schemaName: LABELS_SCHEMA_NAME,
+      messages: labelPrompt(pr, allowed),
+      temperature: 0,
+    });
+    return normalizeLabels(data.labels, allowed);
+  }
+
+  async apply(
+    workspaceId: string,
+    prId: string,
+    labels: string[],
+    token: string | undefined,
+  ): Promise<void> {
+    if (labels.length === 0) return;
+    const pr = await this.requirePull(workspaceId, prId);
+    await this.github(token, `/repos/${pr.owner}/${pr.repo}/issues/${pr.number}/labels`, {
+      method: 'POST',
+      body: JSON.stringify({ labels }),
+    });
+  }
+
+  private async requirePull(workspaceId: string, prId: string): Promise<LabelablePr> {
+    const pr = await this.ports.getPull(workspaceId, prId);
+    if (!pr) throw new NotFoundError('Pull request not found');
+    return pr;
+  }
+
+  private async repoLabels(pr: LabelablePr, token: string | undefined): Promise<string[]> {
+    const res = await this.github(token, `/repos/${pr.owner}/${pr.repo}/labels?per_page=100`);
+    const rows = (await res.json()) as { name: string }[];
+    return rows.map((r) => r.name);
+  }
+
+  private async github(token: string | undefined, path: string, init: RequestInit = {}): Promise<Response> {
+    const res = await fetch(`${GITHUB_API_URL}${path}`, {
+      ...init,
+      headers: {
+        accept: 'application/vnd.github+json',
+        'content-type': 'application/json',
+        ...(token ? { authorization: `Bearer ${token}` } : {}),
+      },
+      signal: AbortSignal.timeout(15_000),
+    });
+    if (!res.ok) throw new ExternalServiceError(`GitHub ${init.method ?? 'GET'} ${path} returned ${res.status}`);
+    return res;
+  }
+}
