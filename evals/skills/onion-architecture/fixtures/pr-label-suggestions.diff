@@ -0,0 +1,39 @@
+import { z } from 'zod';
+import type { ChatMessage } from '@devdigest/shared';
+import type { PullRow } from '../../db/rows.js';
+import { MAX_LABELS } from './constants.js';
+
+export const LabelSuggestion = z.object({
+  labels: z.array(z.string().min(1).max(50)).max(20),
+});
+export type LabelSuggestion = z.infer<typeof LabelSuggestion>;
+
+const MAX_BODY_CHARS = 4_000;
+
+export function labelPrompt(pr: Pick<PullRow, 'title' | 'body'>, allowed: string[]): ChatMessage[] {
+  const body = (pr.body ?? '').slice(0, MAX_BODY_CHARS);
+  return [
+    {
+      role: 'system',
+      content:
+        `You label pull requests. Pick at most ${MAX_LABELS} labels from the allowed list ` +
+        'that describe the change. Never invent a label. Return JSON {"labels": [...]}.',
+    },
+    {
+      role: 'user',
+      content: `Allowed labels:\n${allowed.join('\n')}\n\nTitle: ${pr.title}\n\nDescription:\n${body}`,
+    },
+  ];
+}
+
+/** Keep only labels the repo has (case-insensitive), in the repo's spelling, deduplicated. */
+export function normalizeLabels(suggested: string[], allowed: string[], max = MAX_LABELS): string[] {
+  const byLower = new Map(allowed.map((l) => [l.toLowerCase(), l]));
+  const out: string[] = [];
+  for (const s of suggested) {
+    const hit = byLower.get(s.trim().toLowerCase());
+    if (hit && !out.includes(hit)) out.push(hit);
+    if (out.length === max) break;
+  }
+  return out;
+}
