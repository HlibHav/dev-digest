+import type { FastifyBaseLogger } from 'fastify';
+import { z } from 'zod';
+import type { Container } from '../../platform/container.js';
+import { resolveFeatureModel } from '../settings/feature-models.js';
+import { LABELS_JOB_KIND } from './constants.js';
+import { LabelsService } from './service.js';
+
+const JobPayload = z.object({ workspaceId: z.string().uuid(), prId: z.string().uuid() });
+
+/** Composition for the labels module: ports from the container, plus its job handler. */
+export function buildLabelsService(container: Container, log: FastifyBaseLogger): LabelsService {
+  const reviewRepo = container.reviewRepo;
+
+  const service = new LabelsService({
+    getPull: async (workspaceId, prId) => {
+      const pr = await reviewRepo.getPull(workspaceId, prId);
+      if (!pr) return undefined;
+      const repo = await reviewRepo.getRepo(pr.repoId);
+      if (!repo) return undefined;
+      return { number: pr.number, title: pr.title, body: pr.body, owner: repo.owner, repo: repo.name };
+    },
+    resolveModel: (workspaceId) => resolveFeatureModel(container, workspaceId, 'review_intent'),
+    llm: (provider) => container.llm(provider),
+  });
+
+  container.jobs.register(LABELS_JOB_KIND, async (payload) => {
+    const { workspaceId, prId } = JobPayload.parse(payload);
+    const token = await container.secrets.get('GITHUB_TOKEN');
+    const labels = await service.suggest(workspaceId, prId, token);
+    await service.apply(workspaceId, prId, labels, token);
+    log.info({ prId, labels }, 'labels applied');
+  });
+
+  return service;
+}
